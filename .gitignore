# ── Large data files (not tracked in git) ──────────────────────────────────
# Raw LINCS 2020 GCTX files (~54 GB total)
*.gctx

# Raw metadata files (large, downloaded from LINCS)
siginfo_beta.txt
compoundinfo_beta.txt
geneinfo_beta.txt
cellinfo_beta.txt

# Processed data (generated by pipeline scripts)
data/intermediate/
data/processed/

# Belt-and-suspenders: never commit large numeric artifacts wherever they land.
# (Keep the tiny bundled MSigDB JSON under data/msigdb/ tracked — see negation below.)
*.npy
*.duckdb
*.parquet
*.gctx.gz

# Quarantined trees (raw GCTX inputs + Zenodo upload staging) — never public.
do_not_upload/
data_upload/

# Local build/scratch trees (HPC data build + old upload staging tree) — never public.
cmap_build/
upload/

# Keep the small bundled hallmark gene-set JSON tracked despite *.parquet rule.
!data/msigdb/*.json

# ── Test analysis outputs (not for distribution) ──────────────────────────
analysis/test_genes_enrichment/
analysis/test_genes_enrichment_v2/
test_genes.txt

# ── Local session artifacts (planning docs, generated reports) ────────────
# Keep these out of the public repo. Use docs/ or the GitHub Releases tab
# for anything worth publishing.
implementation_plan.md
report_*.md
report_*.pdf

# ── Jupyter checkpoints ───────────────────────────────────────────────────
.ipynb_checkpoints/

# ── SLURM logs ─────────────────────────────────────────────────────────────
scripts/logs/
slurm_*.out
slurm_*.err
*.out
*.err

# ── Operon / session files ─────────────────────────────────────────────────
.operon-*

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# ── Environment ────────────────────────────────────────────────────────────
.env
.venv/
venv/

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Claude Code ────────────────────────────────────────────────────────────
.claude/
